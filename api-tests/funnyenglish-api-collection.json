    {
      "name": "3. Tests",
      "item": [
        {
          "name": "Get Test by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Test has required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.exist;",
                  "    pm.expect(jsonData.title).to.exist;",
                  "    pm.expect(jsonData.questions).to.be.an('array');",
                  "});",
                  "",
                  "// Save first question ID",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.questions && jsonData.questions.length > 0) {",
                  "    pm.environment.set('question_id', jsonData.questions[0].id);",
                  "    pm.environment.set('answer_id', jsonData.questions[0].answers[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tests/{{test_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tests",
                "{{test_id}}"
              ]
            }
          }
        },
        {
          "name": "Submit Test Results",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has score', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.score).to.exist;",
                  "    pm.expect(jsonData.maxScore).to.exist;",
                  "    pm.expect(jsonData.stars).to.exist;",
                  "});",
                  "",
                  "pm.test('Score is within valid range', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.score).to.be.at.least(0);",
                  "    pm.expect(jsonData.score).to.be.at.most(jsonData.maxScore);",
                  "});",
                  "",
                  "pm.test('Stars is between 0 and 3', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.stars).to.be.at.least(0);",
                  "    pm.expect(jsonData.stars).to.be.at.most(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"testId\": \"{{test_id}}\",\n    \"answers\": [\n        {\n            \"questionId\": \"{{question_id}}\",\n            \"selectedAnswerIds\": [\"{{answer_id}}\"]\n        }\n    ],\n    \"timeSpentSeconds\": 120\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tests/{{test_id}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tests",
                "{{test_id}}",
                "submit"
              ]
            }
          }
        }
      ]
    },
