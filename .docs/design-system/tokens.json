{
  "$schema": "https://design-tokens.org/schema/dtcg-draft.json",
  "$metadata": {
    "name": "FunnyEnglish Speaking Trainer — Design Tokens",
    "version": "1.1.0",
    "style": "Playful Coach (Variant B)",
    "date": "2026-07-31",
    "source": "docs/DESIGN_BRIEF_SPEAKING_TRAINER.md + presentation.html (выбран вариант B владельцем 2026-07-31)",
    "targets": ["Compose M3 :design module", "MUI v6 admin-web/src/theme/Theme.ts"],
    "notes": "Эволюция DS 2.0: пастельная игровая палитра без стриков/гемов; record — дружелюбный персиковый; кнопка записи — squircle с «оттопыренной» тенью. Поведенческие требования мокапов (3 попытки Training, автоотправка Practice) не зависят от варианта."
  },
  "color": {
    "brand": {
      "primary": { "$value": "#5B8DEF", "$type": "color", "$description": "Навигация, ссылки, play-контролы. Пастельный синий DS 2.0" },
      "onPrimary": { "$value": "#FFFFFF", "$type": "color" },
      "primaryContainer": { "$value": "#DDE8FD", "$type": "color", "$description": "Заливка выбранных элементов" },
      "onPrimaryContainer": { "$value": "#1A2F5E", "$type": "color" },
      "secondary": { "$value": "#9B7EDE", "$type": "color", "$description": "Фирменный фиолетовый: акценты, таймер-кольцо уровня 50, чипы" },
      "onSecondary": { "$value": "#FFFFFF", "$type": "color" },
      "secondaryContainer": { "$value": "#E5DCFF", "$type": "color", "$description": "Чипы, подложки заметок (note-bg)" },
      "onSecondaryContainer": { "$value": "#5B3FA8", "$type": "color" },
      "tertiary": { "$value": "#006C4C", "$type": "color", "$description": "Успешные действия, состояние sent" },
      "onTertiary": { "$value": "#FFFFFF", "$type": "color" }
    },
    "semantic": {
      "record": { "$value": "#FF9F6B", "$type": "color", "$description": "Кнопка записи, REC-индикатор. Дружелюбный персиковый, НЕ тревожный красный" },
      "recordActive": { "$value": "#FFB27D", "$type": "color", "$description": "Waveform во время записи" },
      "recordShadow": { "$value": "#D97238", "$type": "color", "$description": "«Оттопыренная» тень rec-кнопки: 0 4px 0 rgba(217,114,56,.55)" },
      "waveformPlayback": { "$value": "#5B8DEF", "$type": "color", "$description": "Waveform при воспроизведении" },
      "success": { "$value": "#43A047", "$type": "color" },
      "warning": { "$value": "#FB8C00", "$type": "color", "$description": "Статус NEW" },
      "error": { "$value": "#E53935", "$type": "color", "$description": "Ошибки. Красный свободен: record больше не красный, путаницы нет" },
      "onError": { "$value": "#FFFFFF", "$type": "color" }
    },
    "timer": {
      "level80": { "$value": "#5B8DEF", "$type": "color", "$description": "Уровень 1, спокойный синий" },
      "level50": { "$value": "#9B7EDE", "$type": "color", "$description": "Уровень 2, фиолетовый" },
      "level30": { "$value": "#FF9F6B", "$type": "color", "$description": "Уровень 3, персиковый (= цвет записи, «экзамен»)" }
    },
    "status": {
      "new": { "$value": "#FB8C00", "$type": "color" },
      "newContainer": { "$value": "#FFE0B2", "$type": "color" },
      "reviewed": { "$value": "#43A047", "$type": "color" },
      "reviewedContainer": { "$value": "#C8E6C9", "$type": "color" }
    },
    "neutral": {
      "background": { "$value": "#EEF3FF", "$type": "color", "$description": "Светлая перивинкл-подложка, игровое настроение" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "surfaceWarm": { "$value": "#E5DCFF", "$type": "color", "$description": "Лавандовая подложка секций/заметок (note-bg)" },
      "surfaceCard": { "$value": "#FFFFFF", "$type": "color", "$description": "Карточка на background" },
      "surfaceVariant": { "$value": "#D8E2FA", "$type": "color", "$description": "Трек таймер-кольца (ring-track)" },
      "outline": { "$value": "#B9C7EE", "$type": "color" },
      "text": { "$value": "#2D3561", "$type": "color", "$description": "Глубокий индиго-чаркоал" },
      "textMuted": { "$value": "#6E76A8", "$type": "color" },
      "scrimSubtitle": { "$value": "#000000B3", "$type": "color", "$description": "Подложка субтитров 70%" },
      "scrimVideoControls": { "$value": "#00000080", "$type": "color" }
    },
    "dark": {
      "background": { "$value": "#161A2E", "$type": "color", "$description": "Индиго-ночь под светлую пастель" },
      "surface": { "$value": "#1F2440", "$type": "color" },
      "surfaceVariant": { "$value": "#2B3152", "$type": "color" },
      "text": { "$value": "#E8EAF6", "$type": "color" },
      "textMuted": { "$value": "#9AA0C4", "$type": "color" },
      "primary": { "$value": "#8FB3F5", "$type": "color" },
      "secondary": { "$value": "#B79EED", "$type": "color" },
      "record": { "$value": "#FFB27D", "$type": "color", "$description": "Осветлён для контраста на тёмном" },
      "outline": { "$value": "#3D4568", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "brand": { "$value": "Nunito, -apple-system, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily", "$description": "Основной шрифт бренда" },
      "mono": { "$value": "'JetBrains Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace", "$type": "fontFamily", "$description": "Таймер, длительности, метаданные. Всегда с font-feature-settings: tnum" }
    },
    "scale": {
      "$type": "dimension",
      "$description": "Major Third 1.25",
      "labelSmall": { "$value": "12px" },
      "bodySmall": { "$value": "14px" },
      "bodyMedium": { "$value": "16px" },
      "titleMedium": { "$value": "20px" },
      "questionText": { "$value": "25px", "$description": "Вопросы читаются с расстояния вытянутой руки, lineHeight 1.35, weight 600" },
      "headlineSmall": { "$value": "31px" },
      "timerDisplay": { "$value": "64px", "$description": "Моноширинные tabular цифры — таймер не прыгает по ширине" },
      "subtitleText": { "$value": "17px", "$description": "16–18px, lineHeight 1.4, поверх scrim" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "4dp-сетка",
    "xs": { "$value": "4px" },
    "s": { "$value": "8px" },
    "m": { "$value": "12px" },
    "l": { "$value": "16px" },
    "xl": { "$value": "24px", "$description": "Минимум между recorder-кнопкой и списком записей" },
    "xxl": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "button": { "$value": "16px", "$description": "Крупнее, чем в A — игровая мягкость" },
    "card": { "$value": "22px", "$description": "Фирменный радиус Variant B" },
    "cardLarge": { "$value": "26px" },
    "sheet": { "$value": "28px", "$description": "Top corners bottom sheet" },
    "chip": { "$value": "12px" },
    "recorder": { "$value": "22px", "$description": "Squircle кнопки записи (НЕ круг!)" },
    "full": { "$value": "999px", "$description": "Pill CTA, чипы-статусы" }
  },
  "size": {
    "$type": "dimension",
    "touchTarget": { "$value": "48px", "$description": "Минимум по a11y" },
    "recorderButton": { "$value": "72px", "$description": "Основная кнопка записи 64–72dp, squircle radius 22px" },
    "recorderButtonSmall": { "$value": "56px" }
  },
  "elevation": {
    "$type": "shadow",
    "card": { "$value": "0 1px 2px rgba(45,53,97,0.06), 0 2px 8px rgba(45,53,97,0.05)", "$description": "1–2dp, тёплая индиго-тень" },
    "fab": { "$value": "0 4px 0 rgba(217,114,56,0.55)", "$description": "«Оттопыренная» жёсткая тень rec-кнопки вниз (игровой стиль), при нажатии схлопывается до 0 1px 0" },
    "sheet": { "$value": "0 -4px 24px rgba(45,53,97,0.12)" },
    "focusRing": { "$value": "0 0 0 2px #EEF3FF, 0 0 0 4px #5B8DEF", "$description": "Двойное кольцо: светлое внутреннее + brand внешнее" }
  },
  "motion": {
    "easingStandard": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "Основной easing UI-переходов" },
    "easingBounce": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "Игровой overshoot для ✅ попыток и появления кнопок" },
    "durationFast": { "$value": "150ms", "$type": "duration" },
    "durationMedium": { "$value": "300ms", "$type": "duration" },
    "durationSlow": { "$value": "500ms", "$type": "duration" },
    "recPulse": { "$value": "1600ms", "$type": "duration", "$description": "Пульсация REC; при Reduce motion — статичный индикатор" },
    "timerAnnounceInterval": { "$value": "5s", "$type": "duration", "$description": "Не чаще — чтобы не спамить TalkBack" }
  }
}
