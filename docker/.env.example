# ========================================
# Production Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ----------------------------------------
# Database Configuration
# ----------------------------------------
DB_NAME=funnyenglish
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# ----------------------------------------
# S3/MinIO Object Storage
# ----------------------------------------
S3_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY
S3_BUCKET=funnyenglish
# см. раздел Domain Configuration ниже (S3_PUBLIC_URL)

# ----------------------------------------
# JWT Configuration
# Minimum 32 characters required!
# ----------------------------------------
JWT_SECRET=CHANGE_THIS_TO_32_PLUS_CHARACTER_RANDOM_STRING

# ----------------------------------------
# Admin User (auto-created on first start)
# ----------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_DISPLAY_NAME=Admin

# ----------------------------------------
# Let's Encrypt / SSL (Caddy получает сертификаты автоматически)
# ----------------------------------------
ACME_EMAIL=your-email@example.com

# ----------------------------------------
# Domain Configuration (нужны DNS A-записи на сервер)
# ----------------------------------------
API_HOST=api.yourdomain.com
ADMIN_HOST=admin.yourdomain.com
MEDIA_HOST=cdn.yourdomain.com
CORS_ORIGINS=https://admin.yourdomain.com
# BUG-004: публичный URL медиа, доступный с устройств (через Caddy → MinIO)
S3_PUBLIC_URL=https://cdn.yourdomain.com/funnyenglish

# ----------------------------------------
# Optional: OAuth Providers
# Uncomment and fill if using social login
# ----------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=

# ----------------------------------------
# Optional: GitHub Container Registry
# For pulling images from ghcr.io
# ----------------------------------------
# GITHUB_REPOSITORY=yourusername/funnyenglish
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
