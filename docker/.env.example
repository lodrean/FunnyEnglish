# ========================================
# Production Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ----------------------------------------
# Database Configuration
# ----------------------------------------
DB_NAME=sotospeak
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# ----------------------------------------
# S3/MinIO Object Storage
# ----------------------------------------
# Дефолт — локальный MinIO из docker-compose.prod.yml (S3_ENDPOINT не задавать).
# Для внешнего российского S3 (Yandex Cloud / Selectel / VK Cloud) — раскомментировать:
# S3_ENDPOINT=https://storage.yandexcloud.net        # Yandex Cloud Object Storage
# S3_ENDPOINT=https://s3.ru1.storage.selcloud.ru     # Selectel
# S3_ENDPOINT=https://hb.bizmrg.com                  # VK Cloud
# S3_REGION=ru-central1                              # ru-central1 / ru-1 / msk1 — по провайдеру
S3_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY
S3_BUCKET=sotospeak
# см. раздел Domain Configuration ниже (S3_PUBLIC_URL — публичный URL, обычно CDN-домен
# перед бакетом, например https://cdn.yourdomain.com/sotospeak)

# ----------------------------------------
# JWT Configuration
# Minimum 32 characters required!
# ----------------------------------------
JWT_SECRET=CHANGE_THIS_TO_32_PLUS_CHARACTER_RANDOM_STRING

# ----------------------------------------
# Admin User (auto-created on first start)
# ----------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_DISPLAY_NAME=Admin

# ----------------------------------------
# Let's Encrypt / SSL (Caddy получает сертификаты автоматически)
# ----------------------------------------
ACME_EMAIL=your-email@example.com

# ----------------------------------------
# Domain Configuration (нужны DNS A-записи на сервер)
# ----------------------------------------
API_HOST=api.yourdomain.com
ADMIN_HOST=admin.yourdomain.com
MEDIA_HOST=cdn.yourdomain.com
CORS_ORIGINS=https://admin.yourdomain.com
# BUG-004: публичный URL медиа, доступный с устройств (через Caddy → MinIO)
S3_PUBLIC_URL=https://cdn.yourdomain.com/sotospeak

# ----------------------------------------
# Email-верификация (SMTP-провайдер: Yandex 360 / Unisender / SendPulse)
# ----------------------------------------
EMAIL_VERIFICATION_ENABLED=true
SPRING_MAIL_HOST=smtp.yandex.ru
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=CHANGE_THIS_SMTP_USERNAME
SPRING_MAIL_PASSWORD=CHANGE_THIS_SMTP_PASSWORD
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true
MAIL_FROM=noreply@yourdomain.com
# Публичный base URL API для ссылок в письмах (БЕЗ /api)
PUBLIC_APP_URL=https://api.yourdomain.com

# ----------------------------------------
# Optional: OAuth Providers
# Uncomment and fill if using social login
# ----------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=

# ----------------------------------------
# Optional: GitHub Container Registry
# For pulling images from ghcr.io
# ----------------------------------------
# GITHUB_REPOSITORY=yourusername/sotospeak
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
