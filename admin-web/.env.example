# Playwright E2E Testing Configuration

# URL админ-панели для тестов
# Для локальной разработки: http://localhost:5173
# Для production: https://admin.sotospeak.com
ADMIN_URL=http://localhost:5173

# Тестовые учетные данные
TEST_ADMIN_EMAIL=admin@sotospeak.com
TEST_ADMIN_PASSWORD=admin123

# Дополнительные тестовые пользователи
TEST_STUDENT_EMAIL=student@test.com
TEST_STUDENT_PASSWORD=student123
TEST_TEACHER_EMAIL=teacher@test.com
TEST_TEACHER_PASSWORD=teacher123

# Настройки playwright
# SKIP_WEB_SERVER=true - не запускать dev сервер автоматически
# Используйте когда сервер уже запущен вручную
SKIP_WEB_SERVER=false

# Для CI/CD
CI=false
