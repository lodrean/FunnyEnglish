# Backend Dockerfile - Pre-built JAR approach
# Build JAR locally first: ./gradlew backend:bootJar -x test
# Then run: docker compose up -d

FROM eclipse-temurin:21-jdk-alpine

# ffprobe/ffmpeg — валидация видео при загрузке (bd FunnyEnglish-h3l.7)
RUN apk add --no-cache ffmpeg

WORKDIR /app

# Copy pre-built JAR (must be built locally before docker build)
COPY backend/build/libs/backend-1.0.0-SNAPSHOT.jar /app/app.jar

EXPOSE 8080

CMD ["java", "-jar", "/app/app.jar"]
