# ========================================
# Staging Environment Configuration
# ========================================
# Copy to docker/.env.staging and fill in your values.
# NEVER commit docker/.env.staging to version control!
#
# Использование:
#   ./gradlew :backend:bootJar
#   docker compose -f docker-compose.staging.yml --env-file docker/.env.staging up -d --build

# ----------------------------------------
# Database
# ----------------------------------------
DB_NAME=sotospeak
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_THIS_STAGING_PASSWORD

# ----------------------------------------
# S3/MinIO (локальный MinIO staging-стека; внешний S3 на staging не нужен)
# ----------------------------------------
S3_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY
S3_BUCKET=sotospeak
# Публичный URL медиа — с устройств/эмулятора localhost НЕ доступен (BUG-004)!
# Для эмулятора Android: http://10.0.2.2:9100/sotospeak
# Для реального устройства: http://<LAN-IP>:9100/sotospeak
S3_PUBLIC_URL=http://10.0.2.2:9100/sotospeak

# ----------------------------------------
# JWT (min 32 chars)
# ----------------------------------------
JWT_SECRET=CHANGE_THIS_TO_32_PLUS_CHARACTER_RANDOM_STRING

# ----------------------------------------
# Admin User (auto-created on first start)
# ----------------------------------------
ADMIN_EMAIL=admin@sotospeak.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_DISPLAY_NAME=Admin

# ----------------------------------------
# CORS (admin staging на 3100)
# ----------------------------------------
CORS_ORIGINS=http://localhost:3100

# ----------------------------------------
# Email-верификация (OpenSpec add-email-verification)
# На staging письма перехватывает Mailpit (UI: http://localhost:8125)
# ----------------------------------------
EMAIL_VERIFICATION_ENABLED=true
MAIL_FROM=noreply@staging.sotospeak.local

# ----------------------------------------
# Rate limits (ослаблены для E2E/приёмки; в prod НЕ выставлять)
# ----------------------------------------
RATE_LIMIT_LOGIN_CAPACITY=100
RATE_LIMIT_REGISTER_CAPACITY=50

# Публичный base URL API для ссылок в письмах верификации
PUBLIC_APP_URL=http://localhost:8180
